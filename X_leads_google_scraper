        "jsCode": "const data = $json.data;\nconst location = $json.location || \"Unknown\";\n\n// Regex patterns\nconst emailRegex = /[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\\.(?!png|jpg|gif|jpeg)[a-zA-Z]{2,}/g;\nconst nameRegex = /\"name\"\\s*:\\s*\"([^\"]+)\"/g;\nconst metaDescriptionRegex = /<meta\\s+name=[\"']description[\"']\\s+content=[\"'](.*?)[\"']/i;\n\n// Extract matches\nconst emails = data.match(emailRegex) || [];\nconst names = [...data.matchAll(nameRegex)].map(m => m[1]);\nconst metaDescriptionMatch = data.match(metaDescriptionRegex);\nconst metaDescription = metaDescriptionMatch ? metaDescriptionMatch[1] : null;\n\n// Build results\nconst results = emails.map((email, index) => ({\n    email: email,\n    agentName: names[index] || null,\n    metaDescription: metaDescription || null,\n    address: location // Always 'bay area' from injected field\n}));\n\nreturn [{ json: { emails: results } }];\n"
