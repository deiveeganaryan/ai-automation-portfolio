        "jsCode": "// Get the query string safely\nconst query = $input.first().json.query\n\n// Terms to remove\nconst removeTerms = [\n  \"real estate agents\",\n  \"real estate agent\",\n  \"real estate teams\",\n  \"real estate team\",\n  \"realtors\",\n  \"realtor\"\n];\n\n// Normalize the query string\nlet location = query.toLowerCase().replace(/\\+/g, \" \");\n\n// Remove the terms\nremoveTerms.forEach(term => {\n  const regex = new RegExp(`\\\\b${term}\\\\b`, \"gi\");\n  location = location.replace(regex, \"\");\n});\n\n// Clean up whitespace\nlocation = location.replace(/\\s+/g, \" \").trim();\n\nreturn {\n  json: {\n    location\n  }\n};\n"
